#!/usr/bin/env bash
# Init-like script to start, stop, and restart manage_my_process
PID_FILE="/var/run/my_process.pid"
case "$1" in
start)
./manage_my_process &
echo "$!" > "$PID_FILE"
echo "manage_my_process started"
;;
stop)
if [ -f "$PID_FILE" ]; then
kill "$(cat "$PID_FILE")"
rm -f "$PID_FILE"
echo "manage_my_process stopped"
else
echo "manage_my_process not running"
fi
;;
restart)
if [ -f "$PID_FILE" ]; then
kill "$(cat "$PID_FILE")"
rm -f "$PID_FILE"
fi
./manage_my_process &
echo "$!" > "$PID_FILE"
echo "manage_my_process restarted"
;;
 *)
echo "Usage: manage_my_process {start|stop|restart}"
exit 1
;;
esac
